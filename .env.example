# Copy to .env and edit. Every value is optional — the app runs fine with none of them.

# Port on the Linux server. Browse to http://<server-ip>:8088
HOST_PORT=8088

# Timezone, so "opened today" lines up with your day.
TZ=America/New_York

# ── QR links ─────────────────────────────────────────────────────────────────
# Where the QR codes should point. Leave blank to use whatever address you
# opened the app on — correct on a home LAN. Set it if you reach the app
# through a reverse proxy or a hostname.
# APP_BASE_URL=http://192.168.1.60:8088

# ── Voice Label Printer ──────────────────────────────────────────────────────
# Print through the relay server, the same path Alexa and Siri use. The token
# must match the relay's LABEL_TOKEN.
# LABEL_RELAY_URL=https://your-relay-server.com
# LABEL_TOKEN=your-secret-token

# Everything below is commented out because the app already applies these
# defaults. Uncomment only what you want to change — an uncommented line here
# always wins, even if it just repeats the default.

# Label size — one of: 2x1, 4x2, 4x6, 3x2, 2x0.5, 1.1x3.5, 1.1x2.4
# This travels with the job, so it applies to filament labels only and leaves
# the printer's saved size alone.
# LABEL_SIZE=2x1

# Print the spool's brand, type and color beside the QR code. On by default —
# set to 0 for a bare code with no text.
# LABEL_QR_SHOW_TEXT=1

# Set to 1 to also print a second, plain-text label with the spool description
# ("Sunlu PLA+ Galaxy Black") after the QR label.
# LABEL_NAME_LABEL=0

# auto (default) uses the relay when it's configured. Set to "direct" only if
# you want to bypass the relay and talk to the Windows client's own web UI.
# LABEL_MODE=auto
# LABEL_CLIENT_URL=http://192.168.1.50:5000

# ── Label scanning ───────────────────────────────────────────────────────────
# Google Cloud Vision API key. Photograph a filament label in the add form and
# the brand, type, color, diameter, weight and temperatures get filled in.
#
# Create one at console.cloud.google.com: enable the Cloud Vision API, then
# APIs & Services -> Credentials -> Create credentials -> API key. Restrict it
# to the Cloud Vision API. One scan is one unit; the free tier is 1000/month.
#
# Leave blank and the scan button simply doesn't appear.
# VISION_API_KEY=
